{
  "name": "@doorway/orchestrator",
  "version": "0.1.0",
  "description": "Doorway Orchestrator - Brain of the agent system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "playwright-core": "^1.60.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@doorway/adapters": "workspace:^",
    "@doorway/core": "workspace:^",
    "@doorway/protocol": "workspace:^",
    "@doorway/terminal-runtime": "workspace:*",
    "better-sqlite3": "^11.0.0"
  }
}
