{
  "name": "@doorway/terminal-runtime",
  "version": "0.1.0",
  "description": "Terminal session management with node-pty",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
